{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "dataset_generated_at": {
      "type": "string"
    },
    "stars_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "dataset_generated_at",
    "stars_sha256",
    "repo_count"
  ],
  "additionalProperties": false
}
