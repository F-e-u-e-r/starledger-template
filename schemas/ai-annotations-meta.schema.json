{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "annotations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "annotation_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "taxonomy_version": {
      "type": "string",
      "const": "1"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "annotations_sha256",
    "annotation_count",
    "taxonomy_version",
    "dataset_sha256",
    "generated_at"
  ],
  "additionalProperties": false
}
